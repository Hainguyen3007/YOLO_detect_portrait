# Stage 1: Builder - Install dependencies
FROM python:3.10-slim AS builder

# Install hệ thống packages cho OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Tạo thư mục làm việc
WORKDIR /app

# Copy requirements và install (chỉ CPU)
COPY requirements.txt .
RUN pip install --no-cache-dir torch==2.2.2+cpu torchvision==0.17.2+cpu \
    -f https://download.pytorch.org/whl/torch_stable.html \
    && pip install --no-cache-dir -r requirements.txt

# Copy code cần thiết
COPY run.py .
COPY 123_aug90_model_ft/weights/best.pt 123_aug90_model_ft/weights/best.pt

# Stage 2: Runtime - Image nhẹ, non-root, CPU-only
FROM python:3.10-slim

# Install chỉ packages hệ thống cần runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Tạo user non-root
RUN useradd -m appuser
USER appuser

# Tạo thư mục làm việc
WORKDIR /app

# Copy deps và code từ builder, bao gồm /usr/local/bin để có uvicorn
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/run.py .
COPY --from=builder /app/123_aug90_model_ft/weights/best.pt 123_aug90_model_ft/weights/best.pt

# Expose port
EXPOSE 8000

# Chạy với uvicorn
CMD ["uvicorn", "run:app", "--host", "0.0.0.0", "--port", "8000"]